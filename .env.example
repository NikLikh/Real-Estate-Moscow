# PostgreSQL (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate
DB_USER=user
DB_PASSWORD=

# Kaggle API: на kaggle.com в Settings, раздел API, Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# VLESS/V2Ray SOCKS5 -- опционально, порт локального SOCKS5 прокси
# если не используете VPN-клиент -- оставить пустым
VLESS_SOCKS_PORT=

# runtime overrides -- опционально, если нужно переопределить scraper.yaml без правки файла
SCRAPER_RUNTIME_ENDPOINT_TYPES=
SCRAPER_EXPERIMENTAL_ENDPOINT_TYPES=
SCRAPER_WEB_PROXY_ENABLED=
