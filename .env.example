# PostgreSQL (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate
DB_USER=user
DB_PASSWORD=password

# Kaggle API: на kaggle.com в Settings, раздел API, Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# VDS -- опционально, для SSH SOCKS5 туннеля как дополнительного endpoint
# если не нужен -- оставить пустым, парсер будет работать через direct IP
VDS_HOST=
VDS_USER=
VDS_PASSWORD=

# VLESS/V2Ray SOCKS5 -- опционально, порт локального SOCKS5 прокси
# если не используете VPN-клиент -- оставить пустым
VLESS_SOCKS_PORT=
